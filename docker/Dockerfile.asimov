ARG BASE_IMAGE=ghcr.io/fenics/dolfinx/dolfinx:v0.9.0
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/nanosystemslab/mis-contact-fea"
LABEL org.opencontainers.image.description="dolfinx v0.9.0 + dolfinx_contact (asimov-contact) — the runtime for mis-contact-fea"
LABEL org.opencontainers.image.licenses="MIT AND LGPL-3.0-or-later"

WORKDIR /opt/asimov-contact
COPY archive/asimov-contact/ /opt/asimov-contact/

RUN cmake -G Ninja -DCMAKE_BUILD_TYPE=Developer -B build-contact -S cpp/ \
 && ninja -C build-contact install

RUN python3 -m pip -v install scipy matplotlib meshio h5py \
 && python3 -m pip -v install -r python/build-requirements.txt \
 && python3 -m pip -v install --no-build-isolation python/
